@model GameStore.Models.Game

@{
    ViewData["Title"] = "Delete";
}

<h1 class="mb-3 text-danger">Delete Game</h1>

<div class="alert alert-warning">
    <strong>Are you sure?</strong> This action cannot be undone.
</div>

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text">
            <strong>Author:</strong> @Model.Author <br />
            <strong>Price:</strong> @Model.Price <br />
            <strong>Release Date:</strong> @Model.releaseDate.ToShortDateString()
        </p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</form>
